{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "制片输出",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "ok",
        "needs_input",
        "unsupported"
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "normalized_brief": {
              "type": "object",
              "properties": {
                "goal": {
                  "enum": [
                    "original_validation",
                    "series_promotion"
                  ]
                },
                "theme": {
                  "anyOf": [
                    {
                      "enum": [
                        "BL",
                        "GL"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "premise": {
                  "type": "string",
                  "minLength": 1
                },
                "audience": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "hook": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ending_constraint": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "must_keep": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "target_duration_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "aspect_ratio": {
                  "enum": [
                    "9:16",
                    "16:9",
                    "1:1"
                  ]
                },
                "target_languages": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "zh-CN",
                      "en",
                      "th"
                    ]
                  },
                  "uniqueItems": true,
                  "maxItems": 3
                }
              },
              "required": [
                "goal",
                "theme",
                "premise",
                "audience",
                "hook",
                "ending_constraint",
                "must_keep",
                "target_duration_ms",
                "aspect_ratio",
                "target_languages"
              ],
              "additionalProperties": false
            },
            "facts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_quote": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "origin": {
                    "enum": [
                      "provided",
                      "proposed"
                    ]
                  }
                },
                "required": [
                  "text",
                  "source_quote",
                  "origin"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "missing_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "proposed_characters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "character_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "goal": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "character_id",
                  "name",
                  "description",
                  "goal"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 2
            }
          },
          "required": [
            "normalized_brief",
            "facts",
            "missing_fields",
            "proposed_characters"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "missing_input",
              "conflicting_input",
              "unsupported_capability",
              "unverifiable",
              "invalid_reference",
              "timing_mismatch",
              "continuity_risk",
              "content_risk",
              "format_risk",
              "manual_review",
              "assumption"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "shot_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "field",
          "shot_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "status",
    "result",
    "issues"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

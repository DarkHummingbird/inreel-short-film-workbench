{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "质检输出",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "ok",
        "needs_input",
        "unsupported"
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "shot_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "asset_ref": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}@v[1-9][0-9]*$"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confidence": {
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "status": {
                    "enum": [
                      "observed",
                      "needs_human"
                    ]
                  },
                  "evidence": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "start_ms": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end_ms": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "suggestion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_source": {
                    "anyOf": [
                      {
                        "enum": [
                          "media",
                          "metadata",
                          "human_note"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "category",
                  "confidence",
                  "status",
                  "evidence",
                  "start_ms",
                  "end_ms",
                  "suggestion",
                  "evidence_source"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "observed"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "evidence": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence_source": {
                          "enum": [
                            "media",
                            "metadata",
                            "human_note"
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              "minItems": 0
            },
            "unverified_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "shot_id",
            "asset_ref",
            "findings",
            "unverified_checks"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "missing_input",
              "conflicting_input",
              "unsupported_capability",
              "unverifiable",
              "invalid_reference",
              "timing_mismatch",
              "continuity_risk",
              "content_risk",
              "format_risk",
              "manual_review",
              "assumption"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "shot_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "field",
          "shot_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "status",
    "result",
    "issues"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

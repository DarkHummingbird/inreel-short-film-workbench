{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "编剧输入",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "brief",
              "concept",
              "script",
              "storyboard",
              "cut",
              "language_assets",
              "delivery",
              "reference",
              "media",
              "policy"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}@v[1-9][0-9]*$"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "task_request": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "brief": {
      "type": "object",
      "properties": {
        "goal": {
          "enum": [
            "original_validation",
            "series_promotion"
          ]
        },
        "theme": {
          "anyOf": [
            {
              "enum": [
                "BL",
                "GL"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "premise": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "hook": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ending_constraint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "must_keep": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "target_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "aspect_ratio": {
          "enum": [
            "9:16",
            "16:9",
            "1:1"
          ]
        },
        "target_languages": {
          "type": "array",
          "items": {
            "enum": [
              "zh-CN",
              "en",
              "th"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        }
      },
      "required": [
        "goal",
        "theme",
        "premise",
        "audience",
        "hook",
        "ending_constraint",
        "must_keep",
        "target_duration_ms",
        "aspect_ratio",
        "target_languages"
      ],
      "additionalProperties": false
    },
    "selected_concept": {
      "type": "object",
      "properties": {
        "concept_key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "hook": {
          "type": "string",
          "minLength": 1
        },
        "character_goals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "character_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              "goal": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "character_id",
              "goal"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 2
        },
        "conflict": {
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "type": "string",
          "minLength": 1
        },
        "ending": {
          "type": "string",
          "minLength": 1
        },
        "visual_motif": {
          "type": "string",
          "minLength": 1
        },
        "production_complexity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "preserved_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "new_elements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "concept_key",
        "title",
        "hook",
        "character_goals",
        "conflict",
        "turn",
        "ending",
        "visual_motif",
        "production_complexity",
        "preserved_facts",
        "new_elements"
      ],
      "additionalProperties": false
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "character_id",
          "name",
          "description",
          "goal"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "source_script": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "review_feedback": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "project_id",
    "sources",
    "task_request",
    "brief",
    "selected_concept",
    "characters",
    "source_script",
    "review_feedback"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "导演输入",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "brief",
              "concept",
              "script",
              "storyboard",
              "cut",
              "language_assets",
              "delivery",
              "reference",
              "media",
              "policy"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}@v[1-9][0-9]*$"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "task_request": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "brief": {
      "type": "object",
      "properties": {
        "goal": {
          "enum": [
            "original_validation",
            "series_promotion"
          ]
        },
        "theme": {
          "anyOf": [
            {
              "enum": [
                "BL",
                "GL"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "premise": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "hook": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ending_constraint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "must_keep": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "target_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "aspect_ratio": {
          "enum": [
            "9:16",
            "16:9",
            "1:1"
          ]
        },
        "target_languages": {
          "type": "array",
          "items": {
            "enum": [
              "zh-CN",
              "en",
              "th"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        }
      },
      "required": [
        "goal",
        "theme",
        "premise",
        "audience",
        "hook",
        "ending_constraint",
        "must_keep",
        "target_duration_ms",
        "aspect_ratio",
        "target_languages"
      ],
      "additionalProperties": false
    },
    "next_checkpoint": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "delivery_reviewer": {
      "const": "reviewer"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}@v[1-9][0-9]*$"
      },
      "minItems": 0
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "missing_input",
              "conflicting_input",
              "unsupported_capability",
              "unverifiable",
              "invalid_reference",
              "timing_mismatch",
              "continuity_risk",
              "content_risk",
              "format_risk",
              "manual_review",
              "assumption"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "shot_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "field",
          "shot_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "review_feedback": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "target_language": {
      "anyOf": [
        {
          "enum": [
            "zh-CN",
            "en",
            "th"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "project_id",
    "sources",
    "task_request",
    "brief",
    "next_checkpoint",
    "artifact_refs",
    "blocking_issues",
    "review_feedback",
    "target_language"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "next_checkpoint": {
            "maximum": 4
          }
        }
      },
      "then": {
        "properties": {
          "target_language": {
            "type": "null"
          }
        }
      }
    }
  ]
}

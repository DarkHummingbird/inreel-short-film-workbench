{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "美术输出",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "ok",
        "needs_input",
        "unsupported"
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "character",
                "keyframe",
                "location",
                "prop",
                "location_view"
              ]
            },
            "image_prompt": {
              "type": "string",
              "minLength": 1
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "reference_map": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "character_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                  },
                  "asset_ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}@v[1-9][0-9]*$"
                  }
                },
                "required": [
                  "character_id",
                  "asset_ref"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "composition": {
              "type": "string",
              "minLength": 1
            },
            "continuity_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "mode",
            "image_prompt",
            "avoid",
            "reference_map",
            "composition",
            "continuity_checks"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "missing_input",
              "conflicting_input",
              "unsupported_capability",
              "unverifiable",
              "invalid_reference",
              "timing_mismatch",
              "continuity_risk",
              "content_risk",
              "format_risk",
              "manual_review",
              "assumption"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "shot_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "field",
          "shot_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "status",
    "result",
    "issues"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

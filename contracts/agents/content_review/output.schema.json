{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "内容审核输出",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "ok",
        "needs_input",
        "unsupported"
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifact_ref": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}@v[1-9][0-9]*$"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rule_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "fragment_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "shot_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "evidence": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "enum": [
                      "observed",
                      "needs_human"
                    ]
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "warning",
                      "high"
                    ]
                  },
                  "suggestion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "asset_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}@v[1-9][0-9]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "start_ms": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end_ms": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "category",
                  "rule_id",
                  "fragment_id",
                  "shot_id",
                  "evidence",
                  "status",
                  "severity",
                  "suggestion",
                  "asset_ref",
                  "start_ms",
                  "end_ms"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "observed"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "evidence": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "anyOf": [
                        {
                          "properties": {
                            "fragment_id": {
                              "type": "string",
                              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                            }
                          }
                        },
                        {
                          "properties": {
                            "asset_ref": {
                              "type": "string",
                              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}@v[1-9][0-9]*$"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "if": {
                      "anyOf": [
                        {
                          "properties": {
                            "start_ms": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        {
                          "properties": {
                            "end_ms": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        }
                      ]
                    },
                    "then": {
                      "properties": {
                        "asset_ref": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}@v[1-9][0-9]*$"
                        },
                        "start_ms": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end_ms": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                ]
              },
              "minItems": 0
            },
            "manual_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "artifact_ref",
            "findings",
            "manual_checks"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "missing_input",
              "conflicting_input",
              "unsupported_capability",
              "unverifiable",
              "invalid_reference",
              "timing_mismatch",
              "continuity_risk",
              "content_risk",
              "format_risk",
              "manual_review",
              "assumption"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "shot_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "field",
          "shot_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "status",
    "result",
    "issues"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

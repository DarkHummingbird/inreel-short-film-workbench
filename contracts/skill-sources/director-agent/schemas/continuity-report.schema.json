{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haoink.local/schemas/continuity-report.schema.json",
  "title": "Director Agent continuity report",
  "type": "object",
  "required": ["schema_version", "review_scope", "summary", "issues", "checked_categories"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0", "1.1.0"]},
    "review_scope": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_id", "severity", "category", "location", "evidence", "impact", "fix", "status"],
        "properties": {
          "issue_id": {"type": "string", "pattern": "^ISS[0-9]{3}$"},
          "severity": {"type": "string", "enum": ["critical", "major", "minor", "suggestion"]},
          "category": {"type": "string", "enum": ["character", "face", "hair", "costume", "prop", "screen-direction", "eyeline", "action", "space", "time", "lighting", "weather", "emotion", "motivation", "axis", "camera-direction", "shot-size-jump", "frame-handoff", "focus", "edit", "prompt", "sound"]},
          "location": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "fix": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["confirmed", "needs-confirmation"]}
        },
        "additionalProperties": false
      }
    },
    "continuity_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_shot_id", "to_shot_id", "end_frame", "start_frame", "anchors", "status"],
        "properties": {
          "from_shot_id": {"type": "string", "pattern": "^SC[0-9]{3}_SH[0-9]{3}$"},
          "to_shot_id": {"type": "string", "pattern": "^SC[0-9]{3}_SH[0-9]{3}$"},
          "end_frame": {"type": "string", "minLength": 1},
          "start_frame": {"type": "string", "minLength": 1},
          "anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"type": "string", "enum": ["matched", "repair-needed", "needs-confirmation"]}
        },
        "additionalProperties": false
      }
    },
    "checked_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["character", "face", "hair", "costume", "prop", "screen-direction", "eyeline", "action", "space", "time", "lighting", "weather", "emotion", "motivation", "axis", "camera-direction", "shot-size-jump", "frame-handoff", "focus", "edit", "prompt", "sound"]}
    }
  },
  "patternProperties": {"^x_": {}},
  "additionalProperties": false
}
